#!/usr/bin/env bash
# git credential helper: answers github.com requests with the per-owner token from
# ~/.config/gh-tokens/<owner>. Needs credential.useHttpPath=true so git sends the path.
# Configured in user provisioning as `credential.helper = sandbox`.
set -euo pipefail

[ "${1:-}" = "get" ] || exit 0   # store/erase: nothing to do

host=""; path=""
while IFS='=' read -r key value; do
  case "$key" in
    host) host=$value ;;
    path) path=$value ;;
  esac
done

[ "$host" = "github.com" ] || exit 0
owner=$(tr '[:upper:]' '[:lower:]' <<<"${path%%/*}")
file="$HOME/.config/gh-tokens/$owner"
[ -n "$owner" ] && [ -f "$file" ] || exit 0

printf 'username=x-access-token\npassword=%s\n' "$(head -n1 "$file")"
